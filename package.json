{
  "name": "multi-platform-subscription-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "MVP subscription service for platform targets, starting with Weibo.",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:server": "pnpm --filter @mpss/server dev",
    "dev:client": "pnpm --filter @mpss/client dev",
    "build": "pnpm --filter @mpss/client build",
    "start": "pnpm --filter @mpss/server start",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @mpss/server db:migrate",
    "db:seed": "pnpm --filter @mpss/server db:seed"
  },
  "engines": {
    "node": ">=20"
  }
}
